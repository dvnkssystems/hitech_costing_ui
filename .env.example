# Frappe backend for the SDK-rendered forms.
#
# Copy to `.env` and point at your bench site. In dev, Vite proxies /api,
# /files, /private, /assets and /printview here, so the browser stays on one
# origin and Frappe's session cookie and CSRF token work without any CORS setup.
VITE_FRAPPE_URL=http://hitech.localhost:8001

# Show "Continue with Google" on the login screen.
#
# Off by default, and deliberately a flag rather than a probe: `Social Login
# Key` is not readable by Guest, so the app cannot detect whether a provider is
# configured — and an unconfigured `login_via_google` returns a 500 page rather
# than failing politely. Set to 1 once the site has a Google Social Login Key
# with social login enabled.
# VITE_ENABLE_GOOGLE_LOGIN=1
